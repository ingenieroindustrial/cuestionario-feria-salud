{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cuestionario-feria-salud",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cuestionario-feria-salud-db",
      "database_id": "1b4d9d35-34ab-46ab-ab06-32ad7da16018"
    }
  ],
  "observability": { "enabled": true }
}
